<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.ProfesorViewController">
    <children>
        <Pane layoutX="10.0" layoutY="10.0" prefHeight="250.0" prefWidth="530.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5;">
            <children>
                <Label layoutX="175.0" layoutY="15.0" text="Gestión de Profesores">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>

                <Label layoutX="30.0" layoutY="50.0" text="ID Profesor:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtIdProfesor" layoutX="140.0" layoutY="46.0" prefWidth="150.0" promptText="Identificador Único" />

                <Label layoutX="30.0" layoutY="85.0" text="Nombre:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtNombre" layoutX="140.0" layoutY="81.0" prefWidth="360.0" promptText="Nombre Completo" />

                <Label layoutX="30.0" layoutY="120.0" text="Email:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtEmail" layoutX="140.0" layoutY="116.0" prefWidth="360.0" promptText="Correo Electrónico" />

                <Label layoutX="30.0" layoutY="155.0" text="Rol:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtRol" layoutX="140.0" layoutY="151.0" prefWidth="120.0" promptText="Rol (Ej: Profesor)" />

                <Label layoutX="270.0" layoutY="155.0" text="Especialidad:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtEspecialidad" layoutX="370.0" layoutY="151.0" prefWidth="130.0" promptText="Área de Experiencia" />

                <Label layoutX="30.0" layoutY="190.0" text="Instrumento:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtInstrumento" layoutX="140.0" layoutY="186.0" prefWidth="120.0" promptText="Instrumento" />

                <Button fx:id="btnCrear" layoutX="60.0" layoutY="220.0" mnemonicParsing="false" onAction="#onCrear" prefWidth="100.0" text="Crear" />
                <Button fx:id="btnActualizar" layoutX="220.0" layoutY="220.0" mnemonicParsing="false" onAction="#onActualizar" prefWidth="100.0" text="Actualizar" />
                <Button fx:id="btnLimpiar" layoutX="380.0" layoutY="220.0" mnemonicParsing="false" onAction="#onLimpiar" prefWidth="100.0" text="Limpiar" />
            </children>
        </Pane>

        <TableView fx:id="tblProfesores" layoutX="10.0" layoutY="270.0" prefHeight="220.0" prefWidth="530.0">
            <columns>
                <TableColumn fx:id="tbcIdProfesor" prefWidth="100.0" text="ID" />
                <TableColumn fx:id="tbcNombre" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="tbcEspecialidad" prefWidth="120.0" text="Especialidad" />
                <TableColumn fx:id="tbcInstrumento" prefWidth="100.0" text="Instrumento" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>

        <Button fx:id="btnEliminar" layoutX="225.0" layoutY="505.0" mnemonicParsing="false" onAction="#onEliminar" prefWidth="100.0" text="Eliminar" />
    </children>
</AnchorPane>