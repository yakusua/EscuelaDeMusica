<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.AdministradorAcademicoViewController">
    <children>
        <Pane layoutX="10.0" layoutY="10.0" prefHeight="250.0" prefWidth="460.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5;">
            <children>
                <Label layoutX="115.0" layoutY="15.0" text="Gestión de Administradores">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>

                <Label layoutX="30.0" layoutY="60.0" text="ID Admin:">
                    <font><Font size="14.0" /></font>
                </Label>
                <TextField fx:id="txtIdAdministrador" layoutX="140.0" layoutY="56.0" prefWidth="290.0" promptText="Identificador Único" />

                <Label layoutX="30.0" layoutY="95.0" text="Nombre:">
                    <font><Font size="14.0" /></font>
                </Label>
                <TextField fx:id="txtNombre" layoutX="140.0" layoutY="91.0" prefWidth="290.0" promptText="Nombre Completo" />

                <Label layoutX="30.0" layoutY="130.0" text="Email:">
                    <font><Font size="14.0" /></font>
                </Label>
                <TextField fx:id="txtEmail" layoutX="140.0" layoutY="126.0" prefWidth="290.0" promptText="Correo Electrónico" />

                <Button fx:id="btnCrear" layoutX="40.0" layoutY="190.0" mnemonicParsing="false" onAction="#onCrear" prefWidth="100.0" text="Crear" />
                <Button fx:id="btnActualizar" layoutX="175.0" layoutY="190.0" mnemonicParsing="false" onAction="#onActualizar" prefWidth="100.0" text="Actualizar" />
                <Button fx:id="btnLimpiar" layoutX="310.0" layoutY="190.0" mnemonicParsing="false" onAction="#onLimpiar" prefWidth="100.0" text="Limpiar" />
            </children>
        </Pane>

        <TableView fx:id="tblAdministradores" layoutX="10.0" layoutY="270.0" prefHeight="220.0" prefWidth="460.0">
            <columns>
                <TableColumn fx:id="tbcIdAdministrador" prefWidth="120.0" text="ID Admin" />
                <TableColumn fx:id="tbcNombre" prefWidth="170.0" text="Nombre" />
                <TableColumn fx:id="tbcEmail" prefWidth="170.0" text="Email" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Button fx:id="btnEliminar" layoutX="190.0" layoutY="505.0" mnemonicParsing="false" onAction="#onEliminar" prefWidth="100.0" text="Eliminar" />
    </children>
</AnchorPane>