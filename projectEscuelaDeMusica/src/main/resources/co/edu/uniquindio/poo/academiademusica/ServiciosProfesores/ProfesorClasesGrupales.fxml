<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>

<?import java.lang.String?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.ServiciosProfesores.ProfesorClasesGrupalesViewController">

    <top>
        <Label text="Clases Grupales"
               style="-fx-font-size: 20px; -fx-padding: 10px;"/>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 20px;">

            <HBox spacing="10">
                <Label text="Instrumento:"/>
                <ComboBox fx:id="cmbInstrumento">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="PIANO"/>
                            <String fx:value="GUITARRA"/>
                            <String fx:value="VIOLIN"/>
                            <String fx:value="CANTO"/>
                            <String fx:value="BATERIA"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Label text="Nivel:"/>
                <ComboBox fx:id="cmbNivel">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="PRINCIPIANTE"/>
                            <String fx:value="INTERMEDIO"/>
                            <String fx:value="AVANZADO"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <HBox spacing="10">
                <Label text="Aula:"/>
                <TextField fx:id="txtAula"/>
                <Label text="Cupos:"/>
                <TextField fx:id="txtCupos"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Horario:"/>
                <TextField fx:id="txtHorario" promptText="Ej: Lunes 14:00 - 16:00"/>
                <Button text="Crear Clase" onAction="#crearClase"/>
                <Button text="Eliminar Clase" onAction="#eliminarClase"/>
            </HBox>

            <TableView fx:id="tablaClases">
                <columns>
                    <TableColumn fx:id="colInst" text="Instrumento"/>
                    <TableColumn fx:id="colNivel" text="Nivel"/>
                    <TableColumn fx:id="colAula" text="Aula"/>
                    <TableColumn fx:id="colCupos" text="Cupos"/>
                    <TableColumn fx:id="colHorario" text="Horario"/>
                </columns>
            </TableView>

            <!-- BOTÓN DE VOLVER -->
            <HBox alignment="CENTER">
                <padding>
                    <Insets top="10" right="0" bottom="5" left="0"/>
                </padding>

                <Button text="Volver"
                        onAction="#volver"
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white;"
                        prefWidth="140"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>

