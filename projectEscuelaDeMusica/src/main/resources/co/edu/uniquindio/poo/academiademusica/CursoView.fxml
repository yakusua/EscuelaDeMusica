<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.CursoViewController">
    <children>
        <Pane layoutX="10.0" layoutY="10.0" prefHeight="220.0" prefWidth="430.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5;">
            <children>
                <Label layoutX="150.0" layoutY="15.0" text="Gestión de Cursos">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>

                <Label layoutX="30.0" layoutY="50.0" text="ID Curso:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtIdCurso" layoutX="140.0" layoutY="46.0" prefWidth="250.0" promptText="Identificador Único del Curso" />

                <Label layoutX="30.0" layoutY="85.0" text="Capacidad:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtCapacidad" layoutX="140.0" layoutY="81.0" prefWidth="100.0" promptText="Número de estudiantes" />

                <Label layoutX="30.0" layoutY="120.0" text="Instrumento:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtInstrumento" layoutX="140.0" layoutY="116.0" prefWidth="120.0" promptText="Instrumento" />

                <Label layoutX="270.0" layoutY="120.0" text="Nivel:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtNivel" layoutX="320.0" layoutY="116.0" prefWidth="70.0" promptText="Nivel" />

                <Button fx:id="btnCrear" layoutX="50.0" layoutY="180.0" mnemonicParsing="false" onAction="#onCrear" prefWidth="100.0" text="Crear" />
                <Button fx:id="btnActualizar" layoutX="175.0" layoutY="180.0" mnemonicParsing="false" onAction="#onActualizar" prefWidth="100.0" text="Actualizar" />
                <Button fx:id="btnLimpiar" layoutX="300.0" layoutY="180.0" mnemonicParsing="false" onAction="#onLimpiar" prefWidth="100.0" text="Limpiar" />
            </children>
        </Pane>

        <TableView fx:id="tblCursos" layoutX="10.0" layoutY="240.0" prefHeight="180.0" prefWidth="430.0">
            <columns>
                <TableColumn fx:id="tbcIdCurso" prefWidth="100.0" text="ID Curso" />
                <TableColumn fx:id="tbcCapacidad" prefWidth="80.0" text="Capacidad" />
                <TableColumn fx:id="tbcInstrumento" prefWidth="120.0" text="Instrumento" />
                <TableColumn fx:id="tbcNivel" prefWidth="100.0" text="Nivel" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>

        <Button fx:id="btnEliminar" layoutX="175.0" layoutY="440.0" mnemonicParsing="false" onAction="#onEliminar" prefWidth="100.0" text="Eliminar" />
    </children>
</AnchorPane>