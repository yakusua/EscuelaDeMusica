<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.EstudianteViewController">
    <children>
        <Pane layoutX="10.0" layoutY="10.0" prefHeight="330.0" prefWidth="580.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5;">
            <children>
                <Label layoutX="175.0" layoutY="15.0" text="Gestión de Estudiantes">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>

                <Label layoutX="30.0" layoutY="50.0" text="ID Estudiante:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtIdEstudiante" layoutX="140.0" layoutY="46.0" prefWidth="150.0" promptText="Identificador Único" />

                <Label layoutX="310.0" layoutY="50.0" text="Edad:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtEdad" layoutX="370.0" layoutY="46.0" prefWidth="150.0" promptText="Edad (int)" />

                <Label layoutX="30.0" layoutY="85.0" text="Nombre:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtNombre" layoutX="140.0" layoutY="81.0" prefWidth="380.0" promptText="Nombre Completo" />

                <Label layoutX="30.0" layoutY="120.0" text="Email:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtEmail" layoutX="140.0" layoutY="116.0" prefWidth="380.0" promptText="Correo Electrónico" />

                <Label layoutX="30.0" layoutY="155.0" text="Rol:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtRol" layoutX="140.0" layoutY="151.0" prefWidth="150.0" promptText="Rol del Estudiante" />

                <Label layoutX="310.0" layoutY="155.0" text="Nivel:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtNivel" layoutX="370.0" layoutY="151.0" prefWidth="150.0" promptText="Nivel (Ej: 'Principiante')" />

                <Label layoutX="30.0" layoutY="190.0" text="Curso Asignado:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtCurso" layoutX="140.0" layoutY="186.0" prefWidth="380.0" promptText="ID o Nombre del Curso" />

                <Label layoutX="30.0" layoutY="225.0" text="Asistencia (%):"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtAsistencia" layoutX="140.0" layoutY="221.0" prefWidth="150.0" promptText="Asistencia (double)" />

                <Label layoutX="310.0" layoutY="225.0" text="Progreso (%):"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtProgreso" layoutX="370.0" layoutY="221.0" prefWidth="150.0" promptText="Progreso (double)" />

                <Button fx:id="btnCrear" layoutX="60.0" layoutY="280.0" mnemonicParsing="false" onAction="#onCrear" prefWidth="100.0" text="Crear" />
                <Button fx:id="btnActualizar" layoutX="240.0" layoutY="280.0" mnemonicParsing="false" onAction="#onActualizar" prefWidth="100.0" text="Actualizar" />
                <Button fx:id="btnLimpiar" layoutX="420.0" layoutY="280.0" mnemonicParsing="false" onAction="#onLimpiar" prefWidth="100.0" text="Limpiar" />
            </children>
        </Pane>

        <TableView fx:id="tblEstudiantes" layoutX="10.0" layoutY="350.0" prefHeight="300.0" prefWidth="580.0">
            <columns>
                <TableColumn fx:id="tbcIdEstudiante" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="tbcNombre" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="tbcNivel" prefWidth="80.0" text="Nivel" />
                <TableColumn fx:id="tbcCurso" prefWidth="100.0" text="Curso" />
                <TableColumn fx:id="tbcAsistencia" prefWidth="85.0" text="Asistencia" />
                <TableColumn fx:id="tbcProgreso" prefWidth="85.0" text="Progreso" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>

        <Button fx:id="btnEliminar" layoutX="250.0" layoutY="665.0" mnemonicParsing="false" onAction="#onEliminar" prefWidth="100.0" text="Eliminar" />
    </children>
</AnchorPane>