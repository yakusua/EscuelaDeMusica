<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.ProfesorViewController"
            prefWidth="750" prefHeight="600">

    <VBox spacing="12" alignment="TOP_CENTER" prefWidth="750" prefHeight="600">
        <padding>
            <Insets top="15" right="20" bottom="15" left="20"/>
        </padding>

        <!-- TÍTULO -->
        <Label text="Gestión Profesores"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <!-- FORMULARIO -->
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                <ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="ID Profesor:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtIdProfesor" promptText="Ej: PROF-001"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNombre" promptText="Nombre completo"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail" promptText="ejemplo@correo.com"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Rol:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbRol" prefWidth="220"
                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Especialidad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEspecialidad" promptText="Ej: Jazz, Clásico"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Instrumento:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbInstrumento" prefWidth="220"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- BOTONES CRUD -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="Agregar" onAction="#onAgregarProfesor"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
            <Button text="Actualizar" onAction="#onActualizarProfesor"
                    style="-fx-background-color: #f1c40f; -fx-text-fill: white;"/>
            <Button text="Eliminar" onAction="#onEliminarProfesor"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Button text="Limpiar" onAction="#onLimpiar"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
        </HBox>

        <!-- TABLA -->
        <TableView fx:id="tblProfesores" prefHeight="260">
            <columns>
                <TableColumn fx:id="tbcId" text="ID" prefWidth="100"/>
                <TableColumn fx:id="tbcNombre" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="tbcEmail" text="Email" prefWidth="180"/>
                <TableColumn fx:id="tbcEspecialidad" text="Especialidad" prefWidth="120"/>
                <TableColumn fx:id="tbcInstrumento" text="Instrumento" prefWidth="120"/>
            </columns>
        </TableView>

        <!-- BOTÓN VOLVER -->
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10" right="0" bottom="5" left="0"/>
            </padding>

            <Button text="Volver"
                    onAction="#volverAlMenuPrincipal"
                    style="-fx-background-color: #7f8c8d; -fx-text-fill: white;"
                    prefWidth="140"/>
        </HBox>
    </VBox>
</AnchorPane>
