<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.ReporteProgresoViewController">
    <children>
        <Pane layoutX="10.0" layoutY="10.0" prefHeight="290.0" prefWidth="530.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5;">
            <children>
                <Label layoutX="150.0" layoutY="15.0" text="Gestión de Reportes de Progreso">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>

                <Label layoutX="30.0" layoutY="50.0" text="ID Estudiante:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtIdEstudiante" layoutX="140.0" layoutY="46.0" prefWidth="360.0" promptText="ID del estudiante" />

                <Label layoutX="30.0" layoutY="85.0" text="ID Curso:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtIdCurso" layoutX="140.0" layoutY="81.0" prefWidth="360.0" promptText="ID del curso" />

                <Label layoutX="30.0" layoutY="120.0" text="Nota:"><font><Font size="14.0" /></font></Label>
                <TextField fx:id="txtNota" layoutX="140.0" layoutY="116.0" prefWidth="100.0" promptText="Nota (double)" />

                <Label layoutX="30.0" layoutY="155.0" text="Observaciones:"><font><Font size="14.0" /></font></Label>
                <TextArea fx:id="txtObservaciones" layoutX="140.0" layoutY="151.0" prefHeight="50.0" prefWidth="360.0" promptText="Comentarios del profesor" />

                <Button fx:id="btnCrear" layoutX="60.0" layoutY="230.0" mnemonicParsing="false" onAction="#onCrear" prefWidth="100.0" text="Crear" />
                <Button fx:id="btnActualizar" layoutX="220.0" layoutY="230.0" mnemonicParsing="false" onAction="#onActualizar" prefWidth="100.0" text="Actualizar" />
                <Button fx:id="btnLimpiar" layoutX="380.0" layoutY="230.0" mnemonicParsing="false" onAction="#onLimpiar" prefWidth="100.0" text="Limpiar" />
            </children>
        </Pane>

        <TableView fx:id="tblReportes" layoutX="10.0" layoutY="310.0" prefHeight="180.0" prefWidth="530.0">
            <columns>
                <TableColumn fx:id="tbcIdEstudiante" prefWidth="130.0" text="ID Estudiante" />
                <TableColumn fx:id="tbcIdCurso" prefWidth="100.0" text="ID Curso" />
                <TableColumn fx:id="tbcNota" prefWidth="50.0" text="Nota" />
                <TableColumn fx:id="tbcObservaciones" prefWidth="250.0" text="Observaciones" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>

        <Button fx:id="btnEliminar" layoutX="225.0" layoutY="505.0" mnemonicParsing="false" onAction="#onEliminar" prefWidth="100.0" text="Eliminar" />
    </children>
</AnchorPane>