<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.SalonViewController">

    <top>
        <VBox spacing="10" style="-fx-padding: 10px;">
            <Label text="Gestión de Salones" style="-fx-font-size: 20px;"/>

            <HBox spacing="10">
                <Label text="Nombre:"/>
                <TextField fx:id="txtNombre"/>
                <Label text="Capacidad:"/>
                <TextField fx:id="txtCapacidad"/>
                <Label text="ID Administrador:"/>
                <TextField fx:id="txtIdAdministrador"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="btnCrear" text="Crear" onAction="#onCrear"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar"/>
                <Button fx:id="btnLimpiar" text="Limpiar" onAction="#onLimpiar"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 10px;">
            <TableView fx:id="tblSalones" prefHeight="300">
                <columns>
                    <TableColumn fx:id="tbcNombre" text="Nombre"/>
                    <TableColumn fx:id="tbcCapacidad" text="Capacidad"/>
                    <TableColumn fx:id="tbcAdministrador" text="Administrador"/>
                </columns>
            </TableView>

            <!-- BOTÓN VOLVER -->
            <HBox alignment="CENTER">
                <padding>
                    <Insets top="10" right="0" bottom="5" left="0"/>
                </padding>

                <Button text="Volver"
                        onAction="#volver"
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white;"
                        prefWidth="140"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
