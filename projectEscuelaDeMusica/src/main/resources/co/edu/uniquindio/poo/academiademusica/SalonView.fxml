<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="480.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.academiademusica.viewController.SalonViewController">

    <children>

        <!-- FORMULARIO -->
        <Pane layoutX="10.0" layoutY="10.0"
              prefHeight="220.0" prefWidth="460.0"
              style="-fx-border-color: #cccccc; -fx-border-radius: 5;">
            <children>

                <Label layoutX="150.0" layoutY="15.0" text="Gestión de Salones">
                    <font><Font name="System Bold" size="18.0"/></font>
                </Label>

                <Label layoutX="30.0" layoutY="50.0" text="Nombre:"/>
                <TextField fx:id="txtNombre" layoutX="180.0" layoutY="46.0"
                           prefWidth="250.0" promptText="Nombre del Salón (Ej: A-101)"/>

                <Label layoutX="30.0" layoutY="85.0" text="Capacidad:"/>
                <TextField fx:id="txtCapacidad" layoutX="180.0" layoutY="81.0"
                           prefWidth="100.0" promptText="Máx. Personas"/>

                <Label layoutX="30.0" layoutY="120.0" text="ID Administrador:"/>
                <TextField fx:id="txtIdAdministrador" layoutX="180.0" layoutY="116.0"
                           prefWidth="250.0" promptText="ID del Administrador responsable"/>

                <Button fx:id="btnCrear" layoutX="60.0" layoutY="180.0"
                        prefWidth="100.0" text="Crear" onAction="#onCrear"/>

                <Button fx:id="btnActualizar" layoutX="200.0" layoutY="180.0"
                        prefWidth="100.0" text="Actualizar" onAction="#onActualizar"/>

                <Button fx:id="btnLimpiar" layoutX="340.0" layoutY="180.0"
                        prefWidth="100.0" text="Limpiar" onAction="#onLimpiar"/>

            </children>
        </Pane>

        <!-- TABLA -->
        <TableView fx:id="tblSalones" layoutX="10.0" layoutY="240.0"
                   prefHeight="180.0" prefWidth="460.0">

            <columns>
                <TableColumn fx:id="tbcNombre" text="Nombre Salón" prefWidth="150.0"/>
                <TableColumn fx:id="tbcCapacidad" text="Capacidad" prefWidth="100.0"/>
                <TableColumn fx:id="tbcAdministrador" text="Administrador (ID)" prefWidth="200.0"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

        <Button fx:id="btnEliminar" layoutX="190.0" layoutY="440.0"
                prefWidth="100.0" text="Eliminar" onAction="#onEliminar"/>

    </children>
</AnchorPane>
